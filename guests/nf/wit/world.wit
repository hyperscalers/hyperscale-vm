package test:guest;

/// The non-fungible fixture: one package serving an issuer that mints and
/// burns, and holders whose instances are entries of their per-resource
/// holdings interval. Id sets cross every boundary in the edge cell
/// framing: one count byte, then that many little-endian u64 ids.
world nf {
    import hyperscale:kernel/state;

    use hyperscale:kernel/state.{bucket, issuer, write-cell, range-write};

    /// Mint one instance: write its data cell and produce the instance
    /// under this method's own issuance grant.
    export mint: func(data: borrow<write-cell>, id: u64, i: borrow<issuer>) -> own<bucket>;

    /// File the arriving instances as holdings entries.
    export deposit: func(holdings: borrow<range-write>, funds: own<bucket>);

    /// Take the named instances out of the holdings interval, trapping on
    /// one not held.
    export withdraw: func(holdings: borrow<range-write>, ids: list<u8>) -> own<bucket>;

    /// Destroy the instances the edge carries; they stop existing.
    export burn: func(funds: own<bucket>, i: borrow<issuer>);

    /// Nothing but its own gate: opens for whoever presents the identity
    /// the configured badge resource names.
    export operate: func();
}
