package test:guest;

/// The non-fungible fixture: one package serving an issuer that mints and
/// burns, and holders whose instances are entries of their per-resource
/// holdings interval. An id set crosses every boundary as the ids it is.
world nf {
    import hyperscale:kernel/state;

    use hyperscale:kernel/state.{bucket, issuer, capability};

    /// Mint one instance: write its data cell and produce the instance
    /// under this method's own issuance grant.
    export mint: func(data: borrow<capability>, id: u64, i: borrow<issuer>) -> own<bucket>;

    /// File the arriving instances as holdings entries.
    export deposit: func(holdings: borrow<capability>, funds: own<bucket>);

    /// Take the named instances out of the holdings interval, trapping on
    /// one not held.
    export withdraw: func(holdings: borrow<capability>, ids: list<u64>) -> own<bucket>;

    /// Destroy the instances the edge carries; they stop existing.
    export burn: func(funds: own<bucket>, i: borrow<issuer>);

    /// Nothing but its own gate: opens for whoever presents the identity
    /// the configured badge resource names.
    export operate: func();

    /// The same, at instance resolution: opens for whoever presents the
    /// one instance the configured resource and id name.
    export operate-instance: func();

    /// The same over an admin set: opens for whoever presents two of the
    /// three configured instances.
    export operate-quorum: func();
}
