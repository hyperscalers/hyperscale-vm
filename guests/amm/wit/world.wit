package test:guest;

/// The constant-product pool: one swap over two reserve cells and a locked
/// fee configuration.
world amm {
    import hyperscale:kernel/state;

    use hyperscale:kernel/state.{write-cell};

    /// Swap `input` against the pool. Returns the output amount, or
    /// declines with an index into the package's error table when the
    /// output does not cover `min-out`.
    ///
    /// The floor is a race the sender loses rather than a defect it
    /// committed, so it is declared rather than trapped: a decline is
    /// priced as the lost race, a trap as the sender's own fault.
    export swap: func(
        reserve-in: borrow<write-cell>,
        reserve-out: borrow<write-cell>,
        input: list<u8>,
        fee-bps: u64,
        min-out: list<u8>,
    ) -> result<list<u8>, u32>;
}
