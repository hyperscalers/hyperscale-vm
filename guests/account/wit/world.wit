package test:guest;

/// The minimal account: reservation-backed withdrawal and delta deposit.
world account {
    import hyperscale:kernel/state;
    import hyperscale:kernel/env;
    import hyperscale:kernel/events;

    use hyperscale:kernel/state.{
        bucket, reserve-cell, delta-cell, write-cell, range-write
    };

    /// Take the reservation as the value it grants.
    ///
    /// No requested amount: the kernel judged and held the reservation
    /// against this method's own declaration before the body ran, so the
    /// grant is the bucket and there is nothing left to check it against.
    export withdraw: func(vault: borrow<reserve-cell>) -> own<bucket>;

    /// Move a bucket into the vault.
    export deposit: func(vault: borrow<delta-cell>, funds: own<bucket>);

    /// Nothing but its own gate: naming this method mints the account's
    /// identity as evidence for later nodes of the same intent. The gate
    /// is judged by the kernel before the export runs — against the rule
    /// stored in the cell this method's own declaration reads — so the
    /// body has nothing left to do.
    export authorize: func();

    /// File the instances the edge carries as holdings entries, each at
    /// the order it was taken under.
    export deposit-nf: func(holdings: borrow<range-write>, funds: own<bucket>);

    /// Take the named instances out of the holdings interval, trapping on
    /// one not held. The removal and the edge are one operation, so a
    /// body cannot hand on what it left where it was.
    export withdraw-nf: func(holdings: borrow<range-write>, ids: list<u8>) -> own<bucket>;

    /// Nothing but its own gate, like authorize: the kernel judges the
    /// holder's rule and the badge-keyed possession reads before the
    /// export runs, and what the call mints is the badge's address.
    export present-badge: func();

    /// Create the stored-authority cell: the caller's roles and recovery
    /// delay, with nothing pending. The cell existing is this body's own
    /// refusal: nothing deletes one, so the transition off the
    /// address-derived rule is one-way.
    export securify: func(cell: borrow<write-cell>, roles: list<u8>, delay-ms: u64);

    /// Append a pending replacement for the whole cell, maturing after
    /// the stored recovery delay; an unmatured proposal is replaced, a
    /// matured one first promoted. Gated by the governing recovery rule.
    export propose: func(cell: borrow<write-cell>, roles: list<u8>, delay-ms: u64);

    /// Drop an unmatured proposal; a matured one is promoted instead —
    /// cancelling what already governs would be a rewrite, not a cancel.
    /// Gated by the governing primary rule.
    export cancel: func(cell: borrow<write-cell>);

    /// Promote the pending proposal now, matured or not: early enactment
    /// and compaction are one operation. Gated by the governing
    /// confirmation rule.
    export confirm: func(cell: borrow<write-cell>);
}
