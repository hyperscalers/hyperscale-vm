package test:guest;

/// The transfer fixture's world: the kernel imports plus one exported method.
world transfer {
    import hyperscale:kernel/state;
    import hyperscale:kernel/env;
    import hyperscale:kernel/crypto;

    use hyperscale:kernel/state.{reserve-cell, delta-cell};

    /// Move the reserved amount into the recipient's delta cell, asserting
    /// it covers `min`; returns a receipt tag folding the clock and a hash
    /// of the randomness draw, so every kernel interface is exercised.
    export run: func(sender: borrow<reserve-cell>, recipient: borrow<delta-cell>, min: u64) -> u64;
}
