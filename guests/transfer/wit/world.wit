package test:guest;

/// The transfer fixture's world: the kernel imports plus one exported method.
world transfer {
    import hyperscale:kernel/state;
    import hyperscale:kernel/env;
    import hyperscale:kernel/crypto;

    use hyperscale:kernel/state.{substate};

    /// Move `amount` from `a` to `b`; returns a receipt tag folding the
    /// clock and a hash of the randomness draw, so every kernel interface
    /// is exercised.
    export run: func(a: borrow<substate>, b: borrow<substate>, amount: u64) -> u64;
}
