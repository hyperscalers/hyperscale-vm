/// The contract world: the only imports a contract component may name.
/// Capability granularity is not in this surface — it comes from which
/// handles the kernel materializes per transaction, and each mode of the
/// effect lattice is its own resource type, so an undeclared mode is as
/// inexpressible as an undeclared key: there is no handle type to receive.
///
/// What a contract *exports* is not declared here — each package owns its
/// own world — but the shapes admitted there are fixed and worth naming
/// beside the imports. A method takes handles, `list<u8>` values and
/// `u64` scalars, and returns `list<u8>`, nothing, or one of those
/// wrapped in `result<_, u32>`. The error arm is the declared refusal
/// channel: the `u32` indexes the package's own error table, and
/// returning on it aborts the transaction as a declared refusal rather
/// than as a defect. A method with no arm cannot decline, and the publish
/// gate holds each signature's totality mark to whichever its export is.
package hyperscale:kernel;

/// Declared-state access, one resource per mode.
interface state {
    /// A quantity at the kernel's own cell width, as its two halves.
    ///
    /// A type rather than the sixteen bytes it is stored as: the width is
    /// the protocol's, so a boundary that carried it as a byte list would
    /// be asking each side to agree by convention on something the type
    /// can simply say. Amounts and order keys are both this — an order
    /// key is a `u128` for the same reason a balance is.
    record amount {
        /// The low 64 bits.
        low: u64,
        /// The high 64 bits.
        high: u64,
    }

    /// Value in the kernel's own keeping.
    ///
    /// A guest holds the handle and the kernel holds the amount; which
    /// resource that amount is denominated in is what a method's declared
    /// outputs say. There is no constructor here, so the only ways to hold
    /// one are to be handed one and to take one from a cell the method
    /// declared — a quantity of value is not something a body can name
    /// into existence. It is owned rather than borrowed because the
    /// canonical ABI routes a discarded owned handle to the host, and
    /// noticing that value was dropped is what a handle buys.
    resource bucket;

    /// The authority to create value.
    ///
    /// Granted to an invocation whose method declares an output the
    /// instance issues itself, and to no other — so a body that never
    /// said it produces what it issues has no handle to name and cannot.
    /// The grant carries no resource: which one the value is denominated
    /// in is what the method's declared outputs say.
    resource issuer;

    /// A declared fresh read of one substate.
    resource read-cell;
    /// A read of one permanently locked substate.
    resource locked-cell;
    /// A declared exclusive read-modify-write of one substate.
    resource write-cell;
    /// A declared commutative movement on one amount cell.
    resource delta-cell;
    /// A declared reservation, already judged feasible and held.
    resource reserve-cell;
    /// A declared read interval of an ordered collection.
    resource range-read;
    /// A declared read-modify-write interval of an ordered collection.
    resource range-write;

    /// The substate's current bytes; empty if absent.
    read-cell-get: func(c: borrow<read-cell>) -> list<u8>;

    /// The substate's pinned bytes; empty if absent.
    locked-cell-get: func(c: borrow<locked-cell>) -> list<u8>;

    /// The substate's current bytes; empty if absent.
    write-cell-get: func(c: borrow<write-cell>) -> list<u8>;

    /// Replace the substate's bytes.
    write-cell-set: func(c: borrow<write-cell>, value: list<u8>);

    /// Debit the amount cell and hand the value out.
    ///
    /// The kernel reads, subtracts and writes back, which is what makes
    /// an absolute cell's value linear: a body that has to read a balance
    /// writes no absolute of its own, so nothing it computes can disagree
    /// with what left. Traps on a stored cell that is not an amount and
    /// on a debit past what it holds.
    write-cell-take: func(c: borrow<write-cell>, amount: amount) -> own<bucket>;

    /// Credit the amount cell with what the bucket carries.
    ///
    /// The bucket is consumed, so what lands in the cell is exactly what
    /// crossed and the body names no number. Traps on a stored cell that
    /// is not an amount and on a total past the cell's width.
    write-cell-put: func(c: borrow<write-cell>, funds: own<bucket>);

    /// Split `amount` off a bucket, as a bucket.
    ///
    /// The one operation that composes value without a cell in it: what
    /// comes off and what is left are one subtraction the kernel
    /// performs, so a body that divides an edge never writes down either
    /// half. Traps past what the bucket holds.
    bucket-take: func(b: borrow<bucket>, amount: amount) -> own<bucket>;

    /// Merge `other` into a bucket, consuming it.
    ///
    /// Traps on a total past the width an amount has.
    bucket-put: func(b: borrow<bucket>, other: own<bucket>);

    /// What a bucket carries.
    ///
    /// A borrow, so asking costs the body nothing: reading how much is in
    /// hand is not moving it. A body needs this wherever its own
    /// arithmetic turns on the value it was paid — a curve, a budget, a
    /// receipt — and reading it is the one thing that cannot create any.
    bucket-amount: func(b: borrow<bucket>) -> amount;

    /// Credit the amount cell.
    delta-cell-add: func(c: borrow<delta-cell>, value: amount);

    /// Debit the amount cell unconditionally.
    delta-cell-sub: func(c: borrow<delta-cell>, value: amount);

    /// Credit the amount cell with what the bucket carries.
    ///
    /// The bucket is consumed, so the credit and the value that crossed
    /// are one number the body never got to write twice.
    delta-cell-put: func(c: borrow<delta-cell>, funds: own<bucket>);

    /// Debit the amount cell and hand the value out.
    ///
    /// The debit is queued like any other, so whether the cell covered it
    /// is the movement fold's question and an over-take aborts at settle
    /// rather than here. What the pairing fixes is that the amount
    /// debited and the amount now in flight are one number.
    delta-cell-take: func(c: borrow<delta-cell>, amount: amount) -> own<bucket>;

    /// The reserved amount this transaction holds.
    reserve-cell-amount: func(c: borrow<reserve-cell>) -> amount;

    /// Create `amount` of the resource this invocation issues.
    ///
    /// The one place a bucket appears with no cell debited behind it, and
    /// the reason it needs a handle rather than a function: what a body
    /// may issue is fixed before it runs, by the declaration the grant
    /// was read off.
    issuer-take: func(i: borrow<issuer>, amount: amount) -> own<bucket>;

    /// Take the reservation, as the value it grants.
    ///
    /// No declared amount: the kernel judged and held the reservation
    /// before this body ran, and the grant is the bucket. Once per
    /// reservation — taking is a question with one answer, where the read
    /// beside it answers every time it is asked.
    reserve-cell-take: func(c: borrow<reserve-cell>) -> own<bucket>;

    /// Entries currently in the interval, bounded by the declared cap.
    range-read-count: func(r: borrow<range-read>) -> u32;

    /// The order key of the entry at `index`, ascending.
    range-read-order: func(r: borrow<range-read>, index: u32) -> amount;

    /// The value of the entry at `index`, ascending.
    range-read-entry: func(r: borrow<range-read>, index: u32) -> list<u8>;

    /// Entries currently in the interval, bounded by the declared cap.
    range-write-count: func(r: borrow<range-write>) -> u32;

    /// The order key of the entry at `index`, ascending.
    range-write-order: func(r: borrow<range-write>, index: u32) -> amount;

    /// The value of the entry at `index`, ascending.
    range-write-entry: func(r: borrow<range-write>, index: u32) -> list<u8>;

    /// Replace the value of the entry at `index`.
    range-write-set: func(r: borrow<range-write>, index: u32, value: list<u8>);

    /// Insert (or replace) the entry at `order`, which must lie inside the
    /// declared interval.
    range-write-insert: func(r: borrow<range-write>, order: amount, value: list<u8>);

    /// Remove the entry at `index`.
    range-write-remove: func(r: borrow<range-write>, index: u32);

    /// Take every entry whose order lies in `[lo, hi]`, as the instances
    /// they were.
    ///
    /// The removal and the edge are one operation, which is what a
    /// movement is for an amount cell and what this is for a collection:
    /// a body cannot hand on instances it left where they were. An empty
    /// range yields an empty bucket, so a method that moves none needs no
    /// way to name one.
    range-write-take: func(r: borrow<range-write>, lo: amount, hi: amount) -> own<bucket>;

    /// File every instance the bucket carries as an entry at the order it
    /// was taken under, consuming it.
    range-write-put: func(r: borrow<range-write>, funds: own<bucket>, value: list<u8>);
}

/// The deterministic environment: identical on every replica for a given
/// transaction, by construction.
interface env {
    /// The transaction clock: the canonical weighted-time anchor of the
    /// payer-shard block that committed this transaction, in milliseconds.
    clock: func() -> u64;

    /// Beacon randomness, domain-separated per transaction. 32 bytes.
    randomness: func() -> list<u8>;
}

/// Host-side cryptography; guests never carry their own.
interface crypto {
    /// The protocol hash function. 32-byte digest.
    hash: func(data: list<u8>) -> list<u8>;
}

/// What a transaction says happened. The emitter is stamped by the kernel
/// from the invocation, never named by the guest, because attribution
/// decides which shard stores the event. Emissions survive only a
/// completed outcome.
interface events {
    /// Emit an event of the calling package's `event-type` with an opaque
    /// payload. Traps past the per-transaction count cap, the per-event
    /// payload cap, or the event-type ceiling.
    emit: func(event-type: u32, payload: list<u8>);
}

/// The world every contract component targets.
world contract {
    import state;
    import env;
    import crypto;
    import events;
}
