/// The contract world: the only imports a contract component may name.
/// Capability granularity is not in this surface — it comes from which
/// sites the kernel lends per transaction. There is no constructor for
/// one, so an undeclared key is inexpressible; what a body may do
/// through a site it was lent is the capability's own answer, held by
/// the kernel at every operation rather than by the handle's type.
///
/// What a contract *exports* is not declared here — each package owns its
/// own world — but the shapes admitted there are fixed and worth naming
/// beside the imports. A method takes handles, `list<u8>` values and
/// `u64` scalars, and returns `list<u8>`, nothing, or one of those
/// wrapped in `result<_, u32>`. The error arm is the declared refusal
/// channel: the `u32` indexes the package's own error table, and
/// returning on it aborts the transaction as a declared refusal rather
/// than as a defect. A method with no arm cannot decline, and the publish
/// gate holds each signature's totality mark to whichever its export is.
package hyperscale:kernel;

/// Declared-state access: one borrowed site, one owned bucket.
interface state {
    use math.{wide};

    /// A quantity at the kernel's own cell width, as its two halves.
    ///
    /// A type rather than the sixteen bytes it is stored as: the width is
    /// the protocol's, so a boundary that carried it as a byte list would
    /// be asking each side to agree by convention on something the type
    /// can simply say. Amounts and order keys are both this — an order
    /// key is a `u128` for the same reason a balance is.
    record amount {
        /// The low 64 bits.
        low: u64,
        /// The high 64 bits.
        high: u64,
    }

    /// A protocol word, as its four little-endian limbs.
    ///
    /// A record rather than the thirty-two bytes it is, on the same
    /// terms as `amount`: the width is the protocol's, so a boundary
    /// carrying it as a byte list would ask each side to agree by
    /// convention on something the type can simply say.
    record word {
        /// Bytes 0 to 7.
        limb0: u64,
        /// Bytes 8 to 15.
        limb1: u64,
        /// Bytes 16 to 23.
        limb2: u64,
        /// Bytes 24 to 31.
        limb3: u64,
    }

    /// What a sealed cell answers when asked for its draw.
    variant drawn {
        /// The epoch the seal matures into is not folded yet. Ask again
        /// once it is.
        pending,
        /// The draw the seal committed to.
        ready(word),
        /// The seal will never open: its epoch fell outside the window
        /// the host keeps, or was rolled by a fallback nobody should
        /// settle value on. Seal again.
        expired,
    }

    /// Value in the kernel's own keeping.
    ///
    /// A guest holds the handle and the kernel holds the amount; which
    /// resource that amount is denominated in is what a method's declared
    /// outputs say. There is no constructor here, so the only ways to hold
    /// one are to be handed one and to take one from a cell the method
    /// declared — a quantity of value is not something a body can name
    /// into existence. It is owned rather than borrowed because the
    /// canonical ABI routes a discarded owned handle to the host, and
    /// noticing that value was dropped is what a handle buys.
    resource bucket;

    /// One declared access, borrowed for the call that acts through it.
    ///
    /// One resource, whatever the mode and whatever the width, because a
    /// handle type answers which table its rep indexes and nothing else:
    /// every site indexes the one the declaration lent. So the type says
    /// nothing about what a body may do through it, and what a body may
    /// do is the capability's own answer, held by the kernel at every
    /// operation — a mode that grants no `set` refuses one on the same
    /// terms it refuses a key that was never declared.
    ///
    /// A site has a width. A plain access is one element wide; a
    /// `for-each` access is as wide as the collection its loop mapped
    /// over, whose width is the instance's rather than the signature's —
    /// which is why one parameter covers a whole site instead of one
    /// element of it. Every operation names the element it acts on, and
    /// one a guard did not fire for is refused by its own name rather
    /// than shortening the walk.
    ///
    /// The world has no constructor for it, which is what makes the
    /// declared set the reachable set.
    resource site;

    /// The substate's current bytes; empty if absent.
    ///
    /// One read for both byte modes: what the exclusive mode adds is the
    /// writes, not a second answer to the same question.
    site-get: func(s: borrow<site>, element: u32) -> list<u8>;

    /// Replace the substate's bytes.
    site-set: func(s: borrow<site>, element: u32, value: list<u8>);

    /// Seal this cell on the epoch now running.
    ///
    /// The kernel writes the epoch, which is the whole of the
    /// commitment: what the seal opens onto is derived from a seed
    /// rolled after the block that wrote it, and a body that named its
    /// own epoch could name one already rolled and open onto a value it
    /// could compute before sealing. So the epoch is not a parameter.
    site-seal: func(s: borrow<site>, element: u32);

    /// The draw the seal in this cell matures into.
    ///
    /// The word is derived from the seed of the epoch the cell's own
    /// seal records plus the protocol's maturity, mixed with the cell's
    /// own key — so what a package gets is fixed by a commitment it
    /// already made and by a value that did not exist when it made one.
    /// Nothing here reads the transaction, which is the whole property:
    /// two attempts at the same seal answer the same word, so there is
    /// nothing to gain by abandoning one.
    ///
    /// On the handle rather than in `env` because the identity is the
    /// cell's. A package that wants two draws holds two cells; one that
    /// passed a nonce would be choosing what the protocol should fix.
    ///
    /// Traps on a cell holding anything but a seal, which only a guest
    /// that wrote its own bytes over one can reach.
    site-open-seal: func(s: borrow<site>, element: u32) -> drawn;

    /// Remove the substate, so nothing is there.
    ///
    /// Its own call rather than a write of no bytes: what a leaf's
    /// presence is stands in the declaration — a mint requires the leaf
    /// absent, a rewrite and a retirement require it present — and a
    /// write whose bytes decided that would make presence a fact about
    /// an encoding rather than about the operation. A body holding the
    /// leaf exclusively may end it; the mode is the same write, and only
    /// the effect on presence is new.
    site-clear: func(s: borrow<site>, element: u32);

    /// What the amount cell holds.
    ///
    /// A borrow, so asking moves nothing, and an `amount` rather than the
    /// bytes it is stored as — the width is the protocol's, and a cell
    /// that holds value has no byte surface for a body to read one
    /// through. The one question about a balance that cannot change it,
    /// and the reason a read of value is a mode at all: a method that
    /// only asks contends with nobody. Answered by the two modes that
    /// hold the cell exclusively; a commutative movement gave up reading
    /// it, which is what makes it commutative.
    site-balance: func(s: borrow<site>, element: u32) -> amount;

    /// Debit the amount cell and hand the value out.
    ///
    /// The pairing fixes that the amount debited and the amount now in
    /// flight are one number the body never got to write twice. When an
    /// over-take is refused is the capability's answer: the exclusive
    /// hold reads, subtracts and writes back, so it traps here, where the
    /// commutative movement queues and leaves the question to the fold.
    /// Traps on a stored cell that is not an amount either way.
    site-take: func(s: borrow<site>, element: u32, amount: amount) -> own<bucket>;

    /// Credit the amount cell with what the bucket carries.
    ///
    /// The bucket is consumed, so what lands in the cell is exactly what
    /// crossed and the body names no number. Refused on the terms
    /// `site-take` states.
    site-put: func(s: borrow<site>, element: u32, funds: own<bucket>);

    /// Take the reservation, as the value it grants.
    ///
    /// No declared amount: the kernel judged and held the reservation
    /// before this body ran, and the grant is the bucket. Once per
    /// reservation — taking is a question with one answer, where the read
    /// beside it answers every time it is asked.
    site-reserve-take: func(s: borrow<site>, element: u32) -> own<bucket>;

    /// Entries currently in the interval, bounded by the declared cap.
    site-count: func(s: borrow<site>, element: u32) -> u32;

    /// Whether the page holds every entry the interval does: a page
    /// short of its cap exhausted the interval, and a full one is
    /// answered by probing past its last entry.
    site-covered: func(s: borrow<site>, element: u32) -> bool;

    /// The order key of the entry at `index`, ascending — which for an
    /// instance is its own id.
    site-order: func(s: borrow<site>, element: u32, index: u32) -> amount;

    /// The value of the entry at `index`, ascending.
    site-entry: func(s: borrow<site>, element: u32, index: u32) -> list<u8>;

    /// Replace the value of the entry at `index`.
    site-entry-set: func(s: borrow<site>, element: u32, index: u32, value: list<u8>);

    /// Insert (or replace) the entry at `order`, which must lie inside the
    /// declared interval.
    site-insert: func(s: borrow<site>, element: u32, order: amount, value: list<u8>);

    /// Remove the entry at `index`.
    site-remove: func(s: borrow<site>, element: u32, index: u32);

    /// Take the named entries, as the instances they were.
    ///
    /// The removal and the edge are one operation, which is what a
    /// movement is for an amount cell and what this is for a collection:
    /// a body cannot hand on instances it left where they were. A method
    /// moving the ids it was given passes them straight through, because
    /// what it was given is what this takes. Naming none yields an empty
    /// bucket, which is how a method that moves nothing gets one. Traps
    /// on an id outside the declared interval and on one the collection
    /// does not hold.
    site-instance-take: func(s: borrow<site>, element: u32, ids: list<u64>) -> own<bucket>;

    /// File every instance the bucket carries as an entry at the order it
    /// was taken under, consuming it.
    site-instance-put: func(s: borrow<site>, element: u32, funds: own<bucket>, value: list<u8>);

    /// Split `amount` off a bucket, as a bucket.
    ///
    /// The one operation that composes value without a cell in it: what
    /// comes off and what is left are one subtraction the kernel
    /// performs, so a body that divides an edge never writes down either
    /// half. Traps past what the bucket holds.
    bucket-take: func(b: borrow<bucket>, amount: amount) -> own<bucket>;

    /// Split a share off a bucket, as a bucket.
    ///
    /// The sibling of `bucket-take`, for the division a body states as a
    /// proportion rather than as a number. What comes off is
    /// `floor(held * num / den)` and what is left is the *remainder* —
    /// derived by subtraction rather than computed a second time — so
    /// the two sum to the input exactly and no rounding argument decides
    /// anything. The dust stays with the bucket that was split, which is
    /// what makes the caller's argument order the whole of the question.
    ///
    /// Traps on a zero denominator and on a share above one, which would
    /// make the remainder negative and denominates nothing.
    bucket-split: func(b: borrow<bucket>, num: wide, den: wide) -> own<bucket>;

    /// Merge `other` into a bucket, consuming it.
    ///
    /// Traps on a total past the width an amount has.
    bucket-put: func(b: borrow<bucket>, other: own<bucket>);

    /// What a bucket carries.
    ///
    /// A borrow, so asking costs the body nothing: reading how much is in
    /// hand is not moving it. A body needs this wherever its own
    /// arithmetic turns on the value it was paid — a curve, a budget, a
    /// receipt — and reading it is the one thing that cannot create any.
    bucket-amount: func(b: borrow<bucket>) -> amount;

    /// Create `amount` of the resource `grant` names.
    ///
    /// The one place a bucket appears with no cell debited behind it.
    /// What a body may issue is fixed before it runs, by the issuances
    /// its own signature declares — `grant` indexes that list, so a
    /// component founding three resources names which of them each call
    /// means, and an index past what the signature declared is refused
    /// here whatever the body asks for.
    mint: func(grant: u32, amount: amount) -> own<bucket>;

    /// Create the named instances of the resource `grant` names.
    ///
    /// The same grants and the same terms as a quantity, for the value
    /// that is counted by name rather than by amount. Traps on a
    /// repeated id and on more than one edge may carry.
    mint-instances: func(grant: u32, ids: list<u64>) -> own<bucket>;

    /// Destroy value this invocation was granted, consuming the bucket.
    ///
    /// The inverse of the two above and under the same grants, and the
    /// one that names none: a bucket carries the resource it holds, and
    /// a mark names one grant, so at most one of the invocation's can be
    /// the bucket's. Bringing value out of existence stays as declared
    /// as bringing it in, which is what keeps a body from simply
    /// forgetting it.
    burn: func(funds: own<bucket>);

    /// How many elements this site covers.
    ///
    /// The element count rather than the count of expansions that fired,
    /// so two sites in one body agree on what an index means and a
    /// guarded one reads undeclared rather than shortening the walk. A
    /// plain access answers one, declared or not.
    site-len: func(s: borrow<site>) -> u32;

    /// Whether this site declared anything for the element at `element`.
    site-declared: func(s: borrow<site>, element: u32) -> bool;
}

/// Wide arithmetic: the operations a contract cannot write itself without
/// either overflowing or rounding twice.
///
/// Not here for determinism — the profile has no floats and a guest's own
/// integer arithmetic is already reproducible. Here because each of these
/// holds an intermediate wider than its operands, which a guest can only
/// emulate: `a * b / c` computed as two guest operations overflows on the
/// product and rounds on the way out of it, where one call holds the whole
/// product and rounds once, at a direction the caller states. The
/// emulation is not underpriced — fuel meters every instruction it takes —
/// it is simply more expensive than the native operation, and it is a
/// second semantics for the two engines to agree on.
///
/// Every function is total on its declared inputs or traps deterministically:
/// there is no arm that returns an approximation.
interface math {
    /// A 256-bit unsigned integer, as four 64-bit limbs, least
    /// significant first.
    ///
    /// The width a fraction's terms travel in. A rate derived from two
    /// balances carries terms at the balances' own scale, and composing
    /// two of them — a cross rate through a numeraire, a health factor
    /// over two prices — squares that, which is past `amount` for any
    /// pool a real market reaches.
    ///
    /// Flat limbs rather than a pair of `amount`s: the profile admits a
    /// record whose every field is a scalar, because that is what makes
    /// it flatten into registers instead of crossing through linear
    /// memory, and a record of records does not satisfy it.
    record wide {
        /// Bits 0 to 63.
        limb0: u64,
        /// Bits 64 to 127.
        limb1: u64,
        /// Bits 128 to 191.
        limb2: u64,
        /// Bits 192 to 255.
        limb3: u64,
    }

    /// Which way a lossy operation resolves a non-zero remainder.
    ///
    /// Required at every call site rather than defaulted, because the
    /// direction decides who keeps the truncated subunit and a default
    /// would answer that question silently.
    enum rounding {
        /// Toward zero.
        down,
        /// Away from zero.
        up,
    }

    /// How two values compare.
    enum ordering {
        /// The first is smaller.
        less,
        /// The two are equal.
        equal,
        /// The first is larger.
        greater,
    }

    /// `a * b / c`, with the product held at 512 bits and one rounding at
    /// the end.
    ///
    /// Traps on a zero divisor and on a quotient past `wide`.
    mul-div: func(a: wide, b: wide, c: wide, r: rounding) -> wide;

    /// `floor(sqrt(a * b))`, with the product held at 512 bits.
    ///
    /// Two arguments rather than one because the caller that needs it is
    /// an initial liquidity mint, where forming `a * b` first is the
    /// overflow this function exists to avoid. A plain square root is
    /// this with `b` at one.
    geometric-mean: func(a: wide, b: wide) -> wide;

    /// `(an/ad) * (bn/bd)`, as a fraction in the same width.
    ///
    /// Multiplies across and reduces by GCD only where the product does
    /// not fit: two terms drawn from a quantity quotient are coprime more
    /// often than not, so reducing every composition would be paying for
    /// the uncommon case. Traps on a zero denominator and where the
    /// product does not fit even reduced.
    fraction-compose: func(an: wide, ad: wide, bn: wide, bd: wide) -> tuple<wide, wide>;

    /// `an/ad` against `bn/bd`, by cross-multiplication at 512 bits.
    ///
    /// A host function because the cross-products leave `wide` for terms
    /// well inside it, so a guest comparing two rates by multiplying
    /// would be comparing the wrong numbers. Traps on a zero denominator.
    fraction-cmp: func(an: wide, ad: wide, bn: wide, bd: wide) -> ordering;

    /// `base` raised to `exp`, at the protocol's fixed scale, by squaring.
    ///
    /// The rounding applies per multiplication rather than to the result,
    /// which is the most a fixed intermediate width allows. Traps where
    /// any intermediate leaves `wide`.
    fixed-pow: func(base: wide, exp: u32, r: rounding) -> wide;
}

/// The deterministic environment: identical on every replica for a given
/// transaction, by construction.
interface env {
    /// The transaction clock: the canonical weighted-time anchor of the
    /// payer-shard block that committed this transaction, in milliseconds.
    clock: func() -> u64;
}

/// Host-side cryptography; guests never carry their own.
interface crypto {
    /// The protocol hash function. 32-byte digest.
    hash: func(data: list<u8>) -> list<u8>;
}

/// What a transaction says happened. The emitter is stamped by the kernel
/// from the invocation, never named by the guest, because attribution
/// decides which shard stores the event. Emissions survive only a
/// completed outcome.
interface events {
    /// Emit an event of the calling package's `event-type` with an opaque
    /// payload. Traps past the per-transaction count cap, the per-event
    /// payload cap, or the event-type ceiling.
    emit: func(event-type: u32, payload: list<u8>);
}

/// The world every contract component targets.
world contract {
    import state;
    import math;
    import env;
    import crypto;
    import events;
}
