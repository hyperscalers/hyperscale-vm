/// The contract world: the only imports a contract component may name.
/// Capability granularity is not in this surface — it comes from which
/// handles the kernel materializes per transaction, and each mode of the
/// effect lattice is its own resource type, so an undeclared mode is as
/// inexpressible as an undeclared key: there is no handle type to receive.
///
/// What a contract *exports* is not declared here — each package owns its
/// own world — but the shapes admitted there are fixed and worth naming
/// beside the imports. A method takes handles, `list<u8>` values and
/// `u64` scalars, and returns `list<u8>`, nothing, or one of those
/// wrapped in `result<_, u32>`. The error arm is the declared refusal
/// channel: the `u32` indexes the package's own error table, and
/// returning on it aborts the transaction as a declared refusal rather
/// than as a defect. A method with no arm cannot decline, and the publish
/// gate holds each signature's totality mark to whichever its export is.
package hyperscale:kernel;

/// Declared-state access, one resource per mode.
interface state {
    use math.{wide};

    /// A quantity at the kernel's own cell width, as its two halves.
    ///
    /// A type rather than the sixteen bytes it is stored as: the width is
    /// the protocol's, so a boundary that carried it as a byte list would
    /// be asking each side to agree by convention on something the type
    /// can simply say. Amounts and order keys are both this — an order
    /// key is a `u128` for the same reason a balance is.
    record amount {
        /// The low 64 bits.
        low: u64,
        /// The high 64 bits.
        high: u64,
    }

    /// A protocol word, as its four little-endian limbs.
    ///
    /// A record rather than the thirty-two bytes it is, on the same
    /// terms as `amount`: the width is the protocol's, so a boundary
    /// carrying it as a byte list would ask each side to agree by
    /// convention on something the type can simply say.
    record word {
        /// Bytes 0 to 7.
        limb0: u64,
        /// Bytes 8 to 15.
        limb1: u64,
        /// Bytes 16 to 23.
        limb2: u64,
        /// Bytes 24 to 31.
        limb3: u64,
    }

    /// What a sealed cell answers when asked for its draw.
    variant drawn {
        /// The epoch the seal matures into is not folded yet. Ask again
        /// once it is.
        pending,
        /// The draw the seal committed to.
        ready(word),
        /// The seal will never open: its epoch fell outside the window
        /// the host keeps, or was rolled by a fallback nobody should
        /// settle value on. Seal again.
        expired,
    }

    /// Value in the kernel's own keeping.
    ///
    /// A guest holds the handle and the kernel holds the amount; which
    /// resource that amount is denominated in is what a method's declared
    /// outputs say. There is no constructor here, so the only ways to hold
    /// one are to be handed one and to take one from a cell the method
    /// declared — a quantity of value is not something a body can name
    /// into existence. It is owned rather than borrowed because the
    /// canonical ABI routes a discarded owned handle to the host, and
    /// noticing that value was dropped is what a handle buys.
    resource bucket;

    /// The authority to create value.
    ///
    /// Granted to an invocation whose method declares an output the
    /// instance issues itself, and to no other — so a body that never
    /// said it produces what it issues has no handle to name and cannot.
    /// The grant carries no resource: which one the value is denominated
    /// in is what the method's declared outputs say.
    resource issuer;

    /// A declared fresh read of one substate.
    resource read-cell;
    /// A declared exclusive read-modify-write of one substate.
    resource write-cell;
    /// The same, over a cell that holds value.
    ///
    /// Its own type rather than a `write-cell` half of whose operations
    /// refuse: bytes are read and replaced, value is credited and
    /// debited, and the two share none. Which one a clause materializes
    /// is what its declaration said the cell holds, so an export that
    /// borrowed the wrong one is answered by the publish gate rather
    /// than by a trap at the call.
    resource amount-cell;
    /// A declared commutative movement on one amount cell.
    resource delta-cell;
    /// A declared reservation, already judged feasible and held.
    resource reserve-cell;
    /// The same read, over a cell that holds value.
    ///
    /// Which of the two a clause materializes is what its declaration
    /// said the cell holds, exactly as it is for `write-cell` and
    /// `amount-cell` — so a read of a vault answers a quantity and a
    /// read of a byte cell answers bytes, and neither export can borrow
    /// the other's.
    resource amount-read;
    /// A declared read interval of an ordered collection.
    resource range-read;
    /// A declared read-modify-write interval of an ordered collection.
    resource range-write;
    /// The same, over entries that are instances of one resource.
    resource instance-range;

    /// A declared `for-each` site's whole expansion, borrowed once and
    /// walked by the index of the element that declared each entry.
    ///
    /// One resource per handle type rather than one shared run: a run
    /// carries exactly the operations its mode carries, so an undeclared
    /// mode is as unreachable through a run as through a single cell.
    /// The width is the instance's rather than the signature's — a list
    /// a loop maps over is configuration's business — which is why one
    /// parameter covers the whole site instead of a run of them.
    ///
    /// Every run answers `len` at the *element* count, so two sites in
    /// one body agree on what an index means, and `declared` at whether
    /// this site's guard fired for that element. Operating through an
    /// index that did not is a body whose control flow disagrees with
    /// its own declaration, and traps on the same terms reaching a
    /// guarded-out handle does.
    resource read-cell-run;
    /// A run of write cells; see `read-cell-run`.
    resource write-cell-run;
    /// A run of amount cells; see `read-cell-run`.
    resource amount-cell-run;
    /// A run of amount reads; see `read-cell-run`.
    resource amount-read-run;
    /// A run of delta cells; see `read-cell-run`.
    resource delta-cell-run;
    /// A run of reserve cells; see `read-cell-run`.
    resource reserve-cell-run;
    /// A run of read intervals; see `read-cell-run`.
    resource range-read-run;
    /// A run of write intervals; see `read-cell-run`.
    resource range-write-run;
    /// A run of instance intervals; see `read-cell-run`.
    resource instance-range-run;

    /// The substate's current bytes; empty if absent.
    read-cell-get: func(c: borrow<read-cell>) -> list<u8>;

    /// What the cell holds, without the exclusivity moving it needs.
    ///
    /// A curve is a function of its reserves, so asking is the one thing
    /// a body does with a balance that changes nothing — and a method
    /// that only asks should contend with nobody. An `amount` rather
    /// than the bytes it is stored as, on the same terms as
    /// `amount-cell-balance`: a cell that holds value has no byte
    /// surface for a body to read one through, whichever handle reaches
    /// it.
    amount-read-balance: func(c: borrow<amount-read>) -> amount;

    /// The substate's current bytes; empty if absent.
    write-cell-get: func(c: borrow<write-cell>) -> list<u8>;

    /// Replace the substate's bytes.
    write-cell-set: func(c: borrow<write-cell>, value: list<u8>);

    /// The draw the seal in this cell matures into.
    ///
    /// The word is derived from the seed of `epoch` plus the protocol's
    /// maturity, mixed with the cell's own key — so what a package gets
    /// is fixed by a commitment it already made and by a value that did
    /// not exist when it made one. Nothing here reads the transaction,
    /// which is the whole property: two attempts at the same seal answer
    /// the same word, so there is nothing to gain by abandoning one.
    ///
    /// On the handle rather than in `env` because the identity is the
    /// cell's. A package that wants two draws holds two cells; one that
    /// passed a nonce would be choosing what the protocol should fix.
    write-cell-open-seal: func(c: borrow<write-cell>, epoch: u64) -> drawn;

    /// Remove the substate, so nothing is there.
    ///
    /// Its own call rather than a write of no bytes: what a leaf's
    /// presence is stands in the declaration — a mint requires the leaf
    /// absent, a rewrite and a retirement require it present — and a
    /// write whose bytes decided that would make presence a fact about
    /// an encoding rather than about the operation. A body holding the
    /// leaf exclusively may end it; the mode is the same write, and only
    /// the effect on presence is new.
    write-cell-clear: func(c: borrow<write-cell>);

    /// What the amount cell holds.
    ///
    /// A borrow, so asking moves nothing, and an `amount` rather than the
    /// bytes it is stored as — the width is the protocol's, and a cell
    /// that holds value has no byte surface for a body to read one
    /// through. The one question about a balance that cannot change it.
    amount-cell-balance: func(c: borrow<amount-cell>) -> amount;

    /// Debit the amount cell and hand the value out.
    ///
    /// The kernel reads, subtracts and writes back, which is what makes
    /// an absolute cell's value linear: a body that has to read a balance
    /// writes no absolute of its own, so nothing it computes can disagree
    /// with what left. Traps on a stored cell that is not an amount and
    /// on a debit past what it holds.
    amount-cell-take: func(c: borrow<amount-cell>, amount: amount) -> own<bucket>;

    /// Credit the amount cell with what the bucket carries.
    ///
    /// The bucket is consumed, so what lands in the cell is exactly what
    /// crossed and the body names no number. Traps on a stored cell that
    /// is not an amount and on a total past the cell's width.
    amount-cell-put: func(c: borrow<amount-cell>, funds: own<bucket>);

    /// Split `amount` off a bucket, as a bucket.
    ///
    /// The one operation that composes value without a cell in it: what
    /// comes off and what is left are one subtraction the kernel
    /// performs, so a body that divides an edge never writes down either
    /// half. Traps past what the bucket holds.
    bucket-take: func(b: borrow<bucket>, amount: amount) -> own<bucket>;

    /// Split a share off a bucket, as a bucket.
    ///
    /// The sibling of `bucket-take`, for the division a body states as a
    /// proportion rather than as a number. What comes off is
    /// `floor(held * num / den)` and what is left is the *remainder* —
    /// derived by subtraction rather than computed a second time — so
    /// the two sum to the input exactly and no rounding argument decides
    /// anything. The dust stays with the bucket that was split, which is
    /// what makes the caller's argument order the whole of the question.
    ///
    /// Traps on a zero denominator and on a share above one, which would
    /// make the remainder negative and denominates nothing.
    bucket-split: func(b: borrow<bucket>, num: wide, den: wide) -> own<bucket>;

    /// Merge `other` into a bucket, consuming it.
    ///
    /// Traps on a total past the width an amount has.
    bucket-put: func(b: borrow<bucket>, other: own<bucket>);

    /// What a bucket carries.
    ///
    /// A borrow, so asking costs the body nothing: reading how much is in
    /// hand is not moving it. A body needs this wherever its own
    /// arithmetic turns on the value it was paid — a curve, a budget, a
    /// receipt — and reading it is the one thing that cannot create any.
    bucket-amount: func(b: borrow<bucket>) -> amount;

    /// Credit the amount cell with what the bucket carries.
    ///
    /// The bucket is consumed, so the credit and the value that crossed
    /// are one number the body never got to write twice.
    delta-cell-put: func(c: borrow<delta-cell>, funds: own<bucket>);

    /// Debit the amount cell and hand the value out.
    ///
    /// The debit is queued like any other, so whether the cell covered it
    /// is the movement fold's question and an over-take aborts at settle
    /// rather than here. What the pairing fixes is that the amount
    /// debited and the amount now in flight are one number.
    delta-cell-take: func(c: borrow<delta-cell>, amount: amount) -> own<bucket>;

    /// Create `amount` of the resource this invocation issues.
    ///
    /// The one place a bucket appears with no cell debited behind it, and
    /// the reason it needs a handle rather than a function: what a body
    /// may issue is fixed before it runs, by the declaration the grant
    /// was read off.
    mint: func(i: borrow<issuer>, amount: amount) -> own<bucket>;

    /// Create the named instances of the resource this invocation issues.
    ///
    /// The same grant and the same terms as a quantity, for the value
    /// that is counted by name rather than by amount. Traps on a
    /// repeated id and on more than one edge may carry.
    mint-instances: func(i: borrow<issuer>, ids: list<u64>) -> own<bucket>;

    /// Destroy what this invocation issues, consuming the bucket.
    ///
    /// The inverse of the two above and under the same grant: bringing
    /// value out of existence is as declared as bringing it in, which is
    /// what keeps a body from simply forgetting it.
    burn: func(i: borrow<issuer>, funds: own<bucket>);

    /// Take the reservation, as the value it grants.
    ///
    /// No declared amount: the kernel judged and held the reservation
    /// before this body ran, and the grant is the bucket. Once per
    /// reservation — taking is a question with one answer, where the read
    /// beside it answers every time it is asked.
    reserve-cell-take: func(c: borrow<reserve-cell>) -> own<bucket>;

    /// Entries currently in the interval, bounded by the declared cap.
    range-read-count: func(r: borrow<range-read>) -> u32;

    /// Whether the page holds every entry the interval does: a page
    /// short of its cap exhausted the interval, and a full one is
    /// answered by probing past its last entry.
    range-read-covered: func(r: borrow<range-read>) -> bool;

    /// The order key of the entry at `index`, ascending.
    range-read-order: func(r: borrow<range-read>, index: u32) -> amount;

    /// The value of the entry at `index`, ascending.
    range-read-entry: func(r: borrow<range-read>, index: u32) -> list<u8>;

    /// Entries currently in the interval, bounded by the declared cap.
    range-write-count: func(r: borrow<range-write>) -> u32;

    /// Whether the page holds every entry the interval does: a page
    /// short of its cap exhausted the interval, and a full one is
    /// answered by probing past its last entry.
    range-write-covered: func(r: borrow<range-write>) -> bool;

    /// The order key of the entry at `index`, ascending.
    range-write-order: func(r: borrow<range-write>, index: u32) -> amount;

    /// The value of the entry at `index`, ascending.
    range-write-entry: func(r: borrow<range-write>, index: u32) -> list<u8>;

    /// Replace the value of the entry at `index`.
    range-write-set: func(r: borrow<range-write>, index: u32, value: list<u8>);

    /// Insert (or replace) the entry at `order`, which must lie inside the
    /// declared interval.
    range-write-insert: func(r: borrow<range-write>, order: amount, value: list<u8>);

    /// Remove the entry at `index`.
    range-write-remove: func(r: borrow<range-write>, index: u32);

    /// Entries currently in the interval, bounded by the declared cap.
    instance-range-count: func(r: borrow<instance-range>) -> u32;

    /// Whether the page holds every entry the interval does: a page
    /// short of its cap exhausted the interval, and a full one is
    /// answered by probing past its last entry.
    instance-range-covered: func(r: borrow<instance-range>) -> bool;

    /// The order key of the entry at `index`, ascending — which for an
    /// instance is its own id.
    instance-range-order: func(r: borrow<instance-range>, index: u32) -> amount;

    /// The value of the entry at `index`, ascending.
    instance-range-entry: func(r: borrow<instance-range>, index: u32) -> list<u8>;

    /// Take the named entries, as the instances they were.
    ///
    /// The removal and the edge are one operation, which is what a
    /// movement is for an amount cell and what this is for a collection:
    /// a body cannot hand on instances it left where they were. A method
    /// moving the ids it was given passes them straight through, because
    /// what it was given is what this takes. Naming none yields an empty
    /// bucket, which is how a method that moves nothing gets one. Traps
    /// on an id outside the declared interval and on one the collection
    /// does not hold.
    instance-range-take: func(r: borrow<instance-range>, ids: list<u64>) -> own<bucket>;

    /// File every instance the bucket carries as an entry at the order it
    /// was taken under, consuming it.
    instance-range-put: func(r: borrow<instance-range>, funds: own<bucket>, value: list<u8>);

    /// How many elements the site's loop mapped over.
    read-cell-run-len: func(r: borrow<read-cell-run>) -> u32;

    /// Whether this site declared anything for the element at `index`.
    read-cell-run-declared: func(r: borrow<read-cell-run>, index: u32) -> bool;

    /// The substate's current bytes; empty if absent.
    read-cell-run-get: func(r: borrow<read-cell-run>, index: u32) -> list<u8>;

    /// How many elements the site's loop mapped over.
    write-cell-run-len: func(r: borrow<write-cell-run>) -> u32;

    /// Whether this site declared anything for the element at `index`.
    write-cell-run-declared: func(r: borrow<write-cell-run>, index: u32) -> bool;

    /// The substate's current bytes; empty if absent.
    write-cell-run-get: func(r: borrow<write-cell-run>, index: u32) -> list<u8>;

    /// Replace the substate's bytes.
    write-cell-run-set: func(r: borrow<write-cell-run>, index: u32, value: list<u8>);

    /// Remove the substate, so nothing is there.
    write-cell-run-clear: func(r: borrow<write-cell-run>, index: u32);

    /// How many elements the site's loop mapped over.
    amount-cell-run-len: func(r: borrow<amount-cell-run>) -> u32;

    /// Whether this site declared anything for the element at `index`.
    amount-cell-run-declared: func(r: borrow<amount-cell-run>, index: u32) -> bool;

    /// What the amount cell holds.
    amount-cell-run-balance: func(r: borrow<amount-cell-run>, index: u32) -> amount;

    /// Debit the cell into a bucket.
    amount-cell-run-take: func(r: borrow<amount-cell-run>, index: u32, amount: amount) -> own<bucket>;

    /// Credit the cell, consuming the bucket.
    amount-cell-run-put: func(r: borrow<amount-cell-run>, index: u32, funds: own<bucket>);

    /// How many elements the site's loop mapped over.
    amount-read-run-len: func(r: borrow<amount-read-run>) -> u32;

    /// Whether this site declared anything for the element at `index`.
    amount-read-run-declared: func(r: borrow<amount-read-run>, index: u32) -> bool;

    /// What the cell holds, without the exclusivity moving it needs.
    amount-read-run-balance: func(r: borrow<amount-read-run>, index: u32) -> amount;

    /// How many elements the site's loop mapped over.
    delta-cell-run-len: func(r: borrow<delta-cell-run>) -> u32;

    /// Whether this site declared anything for the element at `index`.
    delta-cell-run-declared: func(r: borrow<delta-cell-run>, index: u32) -> bool;

    /// Credit the cell commutatively, consuming the bucket.
    delta-cell-run-put: func(r: borrow<delta-cell-run>, index: u32, funds: own<bucket>);

    /// Debit the cell commutatively into a bucket.
    delta-cell-run-take: func(r: borrow<delta-cell-run>, index: u32, amount: amount) -> own<bucket>;

    /// How many elements the site's loop mapped over.
    reserve-cell-run-len: func(r: borrow<reserve-cell-run>) -> u32;

    /// Whether this site declared anything for the element at `index`.
    reserve-cell-run-declared: func(r: borrow<reserve-cell-run>, index: u32) -> bool;

    /// Take the reservation this clause declared and held.
    reserve-cell-run-take: func(r: borrow<reserve-cell-run>, index: u32) -> own<bucket>;

    /// How many elements the site's loop mapped over.
    range-read-run-len: func(r: borrow<range-read-run>) -> u32;

    /// Whether this site declared anything for the element at `index`.
    range-read-run-declared: func(r: borrow<range-read-run>, index: u32) -> bool;

    /// Entries currently in the interval, bounded by the declared cap.
    range-read-run-count: func(r: borrow<range-read-run>, index: u32) -> u32;

    /// Whether the page holds every entry the interval does.
    range-read-run-covered: func(r: borrow<range-read-run>, index: u32) -> bool;

    /// The order key of the entry at `entry`, ascending.
    range-read-run-order: func(r: borrow<range-read-run>, index: u32, entry: u32) -> amount;

    /// The value of the entry at `entry`, ascending.
    range-read-run-entry: func(r: borrow<range-read-run>, index: u32, entry: u32) -> list<u8>;

    /// How many elements the site's loop mapped over.
    range-write-run-len: func(r: borrow<range-write-run>) -> u32;

    /// Whether this site declared anything for the element at `index`.
    range-write-run-declared: func(r: borrow<range-write-run>, index: u32) -> bool;

    /// Entries currently in the interval, bounded by the declared cap.
    range-write-run-count: func(r: borrow<range-write-run>, index: u32) -> u32;

    /// Whether the page holds every entry the interval does.
    range-write-run-covered: func(r: borrow<range-write-run>, index: u32) -> bool;

    /// The order key of the entry at `entry`, ascending.
    range-write-run-order: func(r: borrow<range-write-run>, index: u32, entry: u32) -> amount;

    /// The value of the entry at `entry`, ascending.
    range-write-run-entry: func(r: borrow<range-write-run>, index: u32, entry: u32) -> list<u8>;

    /// Replace the value of the entry at `entry`.
    range-write-run-set: func(r: borrow<range-write-run>, index: u32, entry: u32, value: list<u8>);

    /// Insert (or replace) the entry at `order`, which must lie inside
    /// the declared interval.
    range-write-run-insert: func(r: borrow<range-write-run>, index: u32, order: amount, value: list<u8>);

    /// Remove the entry at `entry`.
    range-write-run-remove: func(r: borrow<range-write-run>, index: u32, entry: u32);

    /// How many elements the site's loop mapped over.
    instance-range-run-len: func(r: borrow<instance-range-run>) -> u32;

    /// Whether this site declared anything for the element at `index`.
    instance-range-run-declared: func(r: borrow<instance-range-run>, index: u32) -> bool;

    /// Entries currently in the interval, bounded by the declared cap.
    instance-range-run-count: func(r: borrow<instance-range-run>, index: u32) -> u32;

    /// Whether the page holds every entry the interval does.
    instance-range-run-covered: func(r: borrow<instance-range-run>, index: u32) -> bool;

    /// The order key of the entry at `entry`, ascending.
    instance-range-run-order: func(r: borrow<instance-range-run>, index: u32, entry: u32) -> amount;

    /// The value of the entry at `entry`, ascending.
    instance-range-run-entry: func(r: borrow<instance-range-run>, index: u32, entry: u32) -> list<u8>;

    /// Take the named instances out of the interval as a bucket.
    instance-range-run-take: func(r: borrow<instance-range-run>, index: u32, ids: list<u64>) -> own<bucket>;

    /// File every instance the bucket carries as an entry at the order it
    /// was taken under, consuming it.
    instance-range-run-put: func(r: borrow<instance-range-run>, index: u32, funds: own<bucket>, value: list<u8>);
}

/// Wide arithmetic: the operations a contract cannot write itself without
/// either overflowing or rounding twice.
///
/// Not here for determinism — the profile has no floats and a guest's own
/// integer arithmetic is already reproducible. Here because each of these
/// holds an intermediate wider than its operands, which a guest can only
/// emulate: `a * b / c` computed as two guest operations overflows on the
/// product and rounds on the way out of it, where one call holds the whole
/// product and rounds once, at a direction the caller states. The
/// emulation is not underpriced — fuel meters every instruction it takes —
/// it is simply more expensive than the native operation, and it is a
/// second semantics for the two engines to agree on.
///
/// Every function is total on its declared inputs or traps deterministically:
/// there is no arm that returns an approximation.
interface math {
    /// A 256-bit unsigned integer, as four 64-bit limbs, least
    /// significant first.
    ///
    /// The width a fraction's terms travel in. A rate derived from two
    /// balances carries terms at the balances' own scale, and composing
    /// two of them — a cross rate through a numeraire, a health factor
    /// over two prices — squares that, which is past `amount` for any
    /// pool a real market reaches.
    ///
    /// Flat limbs rather than a pair of `amount`s: the profile admits a
    /// record whose every field is a scalar, because that is what makes
    /// it flatten into registers instead of crossing through linear
    /// memory, and a record of records does not satisfy it.
    record wide {
        /// Bits 0 to 63.
        limb0: u64,
        /// Bits 64 to 127.
        limb1: u64,
        /// Bits 128 to 191.
        limb2: u64,
        /// Bits 192 to 255.
        limb3: u64,
    }

    /// Which way a lossy operation resolves a non-zero remainder.
    ///
    /// Required at every call site rather than defaulted, because the
    /// direction decides who keeps the truncated subunit and a default
    /// would answer that question silently.
    enum rounding {
        /// Toward zero.
        down,
        /// Away from zero.
        up,
    }

    /// How two values compare.
    enum ordering {
        /// The first is smaller.
        less,
        /// The two are equal.
        equal,
        /// The first is larger.
        greater,
    }

    /// `a * b / c`, with the product held at 512 bits and one rounding at
    /// the end.
    ///
    /// Traps on a zero divisor and on a quotient past `wide`.
    mul-div: func(a: wide, b: wide, c: wide, r: rounding) -> wide;

    /// `floor(sqrt(a * b))`, with the product held at 512 bits.
    ///
    /// Two arguments rather than one because the caller that needs it is
    /// an initial liquidity mint, where forming `a * b` first is the
    /// overflow this function exists to avoid. A plain square root is
    /// this with `b` at one.
    geometric-mean: func(a: wide, b: wide) -> wide;

    /// `(an/ad) * (bn/bd)`, as a fraction in the same width.
    ///
    /// Multiplies across and reduces by GCD only where the product does
    /// not fit: two terms drawn from a quantity quotient are coprime more
    /// often than not, so reducing every composition would be paying for
    /// the uncommon case. Traps on a zero denominator and where the
    /// product does not fit even reduced.
    fraction-compose: func(an: wide, ad: wide, bn: wide, bd: wide) -> tuple<wide, wide>;

    /// `an/ad` against `bn/bd`, by cross-multiplication at 512 bits.
    ///
    /// A host function because the cross-products leave `wide` for terms
    /// well inside it, so a guest comparing two rates by multiplying
    /// would be comparing the wrong numbers. Traps on a zero denominator.
    fraction-cmp: func(an: wide, ad: wide, bn: wide, bd: wide) -> ordering;

    /// `base` raised to `exp`, at the protocol's fixed scale, by squaring.
    ///
    /// The rounding applies per multiplication rather than to the result,
    /// which is the most a fixed intermediate width allows. Traps where
    /// any intermediate leaves `wide`.
    fixed-pow: func(base: wide, exp: u32, r: rounding) -> wide;
}

/// The deterministic environment: identical on every replica for a given
/// transaction, by construction.
interface env {
    /// The transaction clock: the canonical weighted-time anchor of the
    /// payer-shard block that committed this transaction, in milliseconds.
    clock: func() -> u64;

    /// The epoch this transaction executes in.
    ///
    /// What a seal records. How far past its own epoch a seal matures is
    /// the protocol's, so a guest that writes one needs this and nothing
    /// else about epochs.
    epoch: func() -> u64;

    /// Beacon randomness, domain-separated per transaction. 32 bytes.
    randomness: func() -> list<u8>;
}

/// Host-side cryptography; guests never carry their own.
interface crypto {
    /// The protocol hash function. 32-byte digest.
    hash: func(data: list<u8>) -> list<u8>;
}

/// What a transaction says happened. The emitter is stamped by the kernel
/// from the invocation, never named by the guest, because attribution
/// decides which shard stores the event. Emissions survive only a
/// completed outcome.
interface events {
    /// Emit an event of the calling package's `event-type` with an opaque
    /// payload. Traps past the per-transaction count cap, the per-event
    /// payload cap, or the event-type ceiling.
    emit: func(event-type: u32, payload: list<u8>);
}

/// The world every contract component targets.
world contract {
    import state;
    import math;
    import env;
    import crypto;
    import events;
}
